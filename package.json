{
  "name": "GlassBrowser",
  "version": "2.0.0",
  "description": "A modern floating transparent desktop browser",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64",
    "dev": "electron . --dev"
  },
  "repository": "https://github.com/ms12138/glass-browser",
  "keywords": [
    "Floating",
    "Browser",
    "Windows",
    "Electron"
  ],
  "author": "Mitch Samuels & Contributors",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.glassbrowser.app",
    "productName": "Glass Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    }
  }
}
