{
  "name": "GlassBrowser",
  "version": "2.0.0",
  "description": "一个现代化的浮动透明桌面浏览器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win --x64"
  },
  "repository": "https://github.com/ms12138/glass-browser",
  "keywords": [
    "Floating",
    "Browser",
    "Windows",
    "Electron"
  ],
  "author": "Mitch Samuels & Contributors",
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "23.6.0"
  },
  "build": {
    "appId": "com.glassbrowser.app",
    "productName": "Glass Browser",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!releases/**",
      "!.git/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    }
  }
}
